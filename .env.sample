OPENAI_BASE_URL=https://sg.ica.ibm.com/ica/apis/v3
OPENAI_API_KEY=your-api-key-here
DEFAULT_MODEL=global/anthropic.claude-sonnet-4-6

# Optional: cheaper model for background/utility requests (Claude Code sends
# haiku-class model names for chores like generating conversation titles).
# Leave empty to route everything to DEFAULT_MODEL.
SMALL_MODEL=global/anthropic.claude-haiku-4-5-20251001-v1:0

# Tool-call mode. IBM ICA silently strips the native OpenAI `tools` parameter,
# so tool definitions must be injected as XML in the system prompt (true).
# Set false only if your upstream supports native OpenAI function calling.
FORCE_XML_TOOLS=true

# Web search tool configuration
# Provider to use for the built-in web_search tool: "duckduckgo" (default) or "tavily"
WEB_SEARCH_PROVIDER=duckduckgo
# Required when WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Proxy API key — enforced for non-localhost requests (e.g. via ngrok)
# Leave empty to disable key enforcement (all origins allowed without auth)
PROXY_API_KEY=

# Port the proxy listens on (default: 8082)
PROXY_PORT=8082

# Debug logging
# Set to true to write full request/response logs to daily rotating files in DEBUG_LOG_DIR
DEBUG_MODE=false
# Directory where daily debug log files are written (created automatically if missing)
DEBUG_LOG_DIR=logs

# ---------------------------------------------------------------------------
# ICA-2 backend (optional second upstream with limited tokens)
# Leave ICA2_BASE_URL empty to disable ICA-2 entirely.
# ---------------------------------------------------------------------------
ICA2_BASE_URL=https://api.servicesessentials.ibm.com/v1
ICA2_API_KEY=your-ica2-api-key-here

# Emergency model override. When enabled, normal routing still chooses ICA-1
# or ICA-2, then the selected backend's model below replaces the routed model.
# Leave disabled for normal DEFAULT_MODEL / SMALL_MODEL / model_routing.json behavior.
# GPT model available in ICA-1: global/gpt-5
# https://sg.ica.ibm.com/ica/apis/v3/models
# GPT model available in ICA-2: gpt-5.6-terra, gpt-5.6-sol
# https://api.servicesessentials.ibm.com/v1/models

FORCE_MODEL_OVERRIDE=false
ICA1_FORCE_MODEL=global/gpt-5
ICA2_FORCE_MODEL=gpt-5.6-terra

# Model routing is configured in model_routing.json (not in this file).
# See model_routing.json for backend/model mappings.